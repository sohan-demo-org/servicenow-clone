{
  "name": "servicenow-clone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test \"server/**/*.test.ts\"",
    "test:web": "vitest run",
    "reset-db": "rm -f data/servicenow.db data/servicenow.db-*",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "jsdom": "^29.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "~4.1.11"
  },
  "engines": {
    "node": ">=22.18"
  }
}
